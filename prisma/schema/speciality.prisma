model Specialty {
  id String @id @default(uuid())

  title       String   @unique @db.VarChar(100)
  description String?  @db.Text
  icon        String?  @db.VarChar(225)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  isDeleted         Boolean            @default(false)
  deletedAt         DateTime?
  doctorSpecialties DoctorSpeciality[]

  @@index([isDeleted], name: "idx_specialty_isDeleted")
  @@index([title], name: "idx_specialty_title")
  @@map("specialties")
}

model DoctorSpeciality {
  id           String @id @default(uuid(7))
  doctorId     String
  specialityId String

  // relation
  doctor    Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  specialty Specialty @relation(fields: [specialityId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([doctorId, specialityId])
  @@index([doctorId], name: "idx_doctor_specialty_doctorId")
  @@index([specialityId], name: "idx_doctor_specialty_specialtyId")
  @@map("doctor_specialties")
}
